{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "W4DJ RKB",
  "mainBinaryName": "w4dj-desktop",
  "version": "3.2.3",
  "identifier": "com.slipstream.w4dj",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1423",
    "frontendDist": "../app/dist"
  },
  "app": {
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "resources/essentia-models/**/*": "essentia-models"
    }
  }
}
